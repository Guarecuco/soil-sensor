<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
    <applicability>
        <when>
            <context
                deviceFamily="ARM"
                deviceId="Cortex M.CC2340R53"
            />
        </when>
    </applicability>

    <project
        title="soil_sensor app"
        name="soil_sensor_LP_EM_CC2340R53_freertos_ticlang"
        configurations="Release, Debug"
        toolChain="TICLANG"
        connection="TIXDS110_Connection.xml"
        device="Cortex M.CC2340R53"
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="true"
        products="com.ti.SIMPLELINK_LOWPOWER_F3_SDK;sysconfig"
        compilerBuildOptions="
            -I${PROJECT_ROOT}
            -I${PROJECT_ROOT}/${ConfigName}
            -I${PROJECT_LOC}/app
            -DICALL_NO_APP_EVENTS
            -mthumb
            -mlittle-endian
            -std=gnu99
            -std=c99
            -ffunction-sections
            -g
            -Oz
            -I${COM_TI_SIMPLELINK_LOWPOWER_F3_SDK_INSTALL_DIR}/source
            -I${COM_TI_SIMPLELINK_LOWPOWER_F3_SDK_INSTALL_DIR}/source/ti
            -I${COM_TI_SIMPLELINK_LOWPOWER_F3_SDK_INSTALL_DIR}/source/ti/common/cc26xx
            @${COM_TI_SIMPLELINK_LOWPOWER_F3_SDK_INSTALL_DIR}/source/ti/ble/stack_util/config/build_components.opt
            @${COM_TI_SIMPLELINK_LOWPOWER_F3_SDK_INSTALL_DIR}/source/ti/ble/stack_util/config/factory_config.opt
            -I${COM_TI_SIMPLELINK_LOWPOWER_F3_SDK_INSTALL_DIR}/source/third_party/mbedtls/include
            -I${COM_TI_SIMPLELINK_LOWPOWER_F3_SDK_INSTALL_DIR}/source/third_party/mbedtls/ti
            -DMBEDTLS_CONFIG_FILE=&quot;configs/config-hsm.h&quot;
            -DMBEDTLS_PSA_CRYPTO_CONFIG_FILE=&quot;configs/config-psa-crypto-hsm.h&quot;
            -I${COM_TI_SIMPLELINK_LOWPOWER_F3_SDK_INSTALL_DIR}/source/third_party/mcuboot/boot/bootutil/include
            -I${COM_TI_SIMPLELINK_LOWPOWER_F3_SDK_INSTALL_DIR}/source/third_party/mcuboot/boot/ti/source/mcuboot_app
            -I${COM_TI_SIMPLELINK_LOWPOWER_F3_SDK_INSTALL_DIR}/source/ti/common/cc26xx/flash_interface
            -DNVOCMP_NVPAGES=6
            -DNVOCMP_POSIX_MUTEX
            -DNVOCMP_NWSAMEITEM=1
            -I${COM_TI_SIMPLELINK_LOWPOWER_F3_SDK_INSTALL_DIR}/source/ti/drivers/rcl
            -Wunused-function
            -I${COM_TI_SIMPLELINK_LOWPOWER_F3_SDK_INSTALL_DIR}/source/ti/posix/ticlang
            -DFREERTOS
            -I${COM_TI_SIMPLELINK_LOWPOWER_F3_SDK_INSTALL_DIR}/kernel/freertos
            -I${COM_TI_SIMPLELINK_LOWPOWER_F3_SDK_INSTALL_DIR}/source/third_party/freertos/include
            -I${COM_TI_SIMPLELINK_LOWPOWER_F3_SDK_INSTALL_DIR}/source/third_party/freertos/portable/GCC/ARM_CM0
            -mcpu=cortex-m0plus
            -march=thumbv6m
            -mfloat-abi=soft
            -Wall
        "
        linkerBuildOptions="
            -Wl,--diag_wrap=off
            -Wl,--display_error_number
            -Wl,-x
            -Wl,-c
            -L${COM_TI_SIMPLELINK_LOWPOWER_F3_SDK_INSTALL_DIR}/source
            -L${PROJECT_BUILD_DIR}/syscfg
            -lti_utils_build_linker.cmd.genlibs
            -Wl,--rom_model
            -Wl,--warn_sections
            -L${CG_TOOL_ROOT}/lib
            -llibc.a
        "
        preBuildStep="
            ${COM_TI_SIMPLELINK_LOWPOWER_F3_SDK_INSTALL_DIR}/tools/ble/oad/commands_runner --cfg_file ${SYSCONFIG_TOOL_OUTPUT_DIR}/ti_ble_oad_prebuild.cfg --compiler ticlang --build_dir ${BuildDirectory} --gmake_dir ${CCS_INSTALL_ROOT}/utils/bin/gmake --sysconfig_cli ${SYSCONFIG_TOOL} --execute_sysconfig --sdk_dir ${COM_TI_SIMPLELINK_LOWPOWER_F3_SDK_INSTALL_DIR}
        "
        postBuildStep="
            ${COM_TI_SIMPLELINK_LOWPOWER_F3_SDK_INSTALL_DIR}/tools/common/crc_tool/crc_tool patch-image --elf ${BuildArtifactFileBaseName}.out --symbol-prefix ti_utils_build_GenMap_sym_CRC_CCFG -o ${BuildArtifactFileBaseName}.out;
            ${CG_TOOL_ROOT}/bin/tiarmobjcopy -O ihex ${BuildArtifactFileBaseName}.out ${BuildArtifactFileBaseName}.hex;
            ${COM_TI_SIMPLELINK_LOWPOWER_F3_SDK_INSTALL_DIR}/tools/ble/oad/commands_runner --cfg_file ${SYSCONFIG_TOOL_OUTPUT_DIR}/ti_ble_oad_postbuild.cfg --compiler ticlang --cg_tool_root ${CG_TOOL_ROOT} --build_dir ${BuildDirectory} --base_name ${BuildArtifactFileBaseName} --sdk_dir ${COM_TI_SIMPLELINK_LOWPOWER_F3_SDK_INSTALL_DIR}
        "
        sysConfigBuildOptions="
            --product ${COM_TI_SIMPLELINK_LOWPOWER_F3_SDK_INSTALL_DIR}/.metadata/product.json
            --compiler ticlang
        "
        description="Soil moisture sensor BLE peripheral">
        <property name="buildProfile" value="release"/>
        <property name="isHybrid" value="true"/>
